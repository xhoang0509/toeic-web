{
  "name": "toeic-web",
  "version": "1.0.0",
  "description": "Hệ thống thi và đánh giá năng lực tiếng Anh TOEIC Online (Astro + React) với backend Cloudflare Workers + D1: chấm điểm phía server, Bảng Xếp Hạng thật, luyện tập từng Part và quản trị thí sinh",
  "main": "index.html",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/normalize-questions.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "data:normalize": "node scripts/normalize-questions.mjs",
    "data:seed-sql": "node scripts/build-seed-sql.mjs",
    "db:migrate": "npx wrangler d1 execute toeic-db --remote --config cloudflare/wrangler.toml --file=cloudflare/migrations/0001_init.sql",
    "db:seed": "npm run data:normalize && npm run data:seed-sql && npx wrangler d1 execute toeic-db --remote --config cloudflare/wrangler.toml --file=cloudflare/migrations/0002_seed_questions.sql",
    "api:dev": "npx wrangler dev --config cloudflare/wrangler.toml",
    "api:deploy": "npx wrangler deploy --config cloudflare/wrangler.toml",
    "api:logs": "npx wrangler tail toeic-api",
    "extract": "node scripts/extract_quiz.js",
    "inject": "node scripts/inject_answers.js",
    "markdown": "node scripts/generate_markdown.js"
  },
  "keywords": [
    "toeic",
    "exam",
    "assessment",
    "elearning",
    "quiz",
    "english",
    "leaderboard",
    "static-site"
  ],
  "author": "xhoang0509",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xhoang0509/toeic-web.git"
  },
  "bugs": {
    "url": "https://github.com/xhoang0509/toeic-web/issues"
  },
  "homepage": "https://xhoang0509.github.io/toeic-web/",
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/tailwind": "^6.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "vitest": "^5.0.3"
  }
}
