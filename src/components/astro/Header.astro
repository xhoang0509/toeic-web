---
import { TopNavActions } from '../react/TopNavActions';
import { AnnouncementBanner } from '../react/AnnouncementBanner';

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}/`, label: 'Trang Chủ' },
  { href: `${base}/practice`, label: 'Luyện Từng Part' },
  { href: `${base}/exam`, label: 'Thi Thử 120p', highlight: true },
  { href: `${base}/leaderboard`, label: 'Bảng Xếp Hạng' },
  { href: `${base}/mistakes`, label: 'Sổ Tay Câu Sai' },
];
---

<header class="sticky top-0 z-30 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 transition-colors">
  <AnnouncementBanner client:load />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href={`${base}/`} class="flex items-center gap-2.5 shrink-0 group">
      <img
        src={`${base}/logo.svg`}
        alt="TOEIC Assessment Logo"
        class="w-9 h-9 rounded-xl shadow-md shadow-sky-600/20 group-hover:scale-105 transition-transform"
      />
      <div class="flex flex-col">
        <span class="font-extrabold text-base tracking-tight text-slate-900 dark:text-white leading-tight">
          TOEIC<span class="text-sky-600">.EDU</span>
        </span>
        <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400">
          Assessment & Prep
        </span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 text-xs font-semibold">
      {navLinks.map((item) => {
        const isActive = pathname === item.href || (item.href !== `${base}/` && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`px-3.5 py-2 rounded-xl transition-all ${
              item.highlight
                ? 'bg-sky-600 text-white hover:bg-sky-500 shadow-sm shadow-sky-600/20 font-bold ml-1'
                : isActive
                ? 'bg-slate-100 text-sky-700 dark:bg-slate-800 dark:text-sky-400 font-bold'
                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/60'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Profile / Mistakes Actions -->
    <TopNavActions client:load />
  </div>
</header>
